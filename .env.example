# Copy to .env locally or set these in Coolify environment variables.
TELEGRAM_BOT_TOKEN=replace-me
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Defaults chosen for HIFI WALKER H2 Mini compatibility.
OUTPUT_FORMAT=mp3
MAX_DURATION_SECONDS=1800
MAX_OUTPUT_BYTES=52428800
MAX_SOURCE_BYTES=157286400

# Optional YouTube anti-bot workarounds. Treat cookies/proxy credentials as secrets.
# Prefer YTDLP_COOKIES_B64 in Coolify: base64-encoded Netscape cookies.txt.
YTDLP_COOKIES_B64=
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
MUSIC_BOT_WORKDIR=/tmp/music-bot
